<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>lol.ssj.thundergate.TGDext</string>
	<key>CFBundleIdentifier</key>
	<string>lol.ssj.thundergate.TGDext</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>TGDext</string>
	<key>CFBundlePackageType</key>
	<string>DEXT</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>6</string>
	<key>OSBundleUsageDescription</key>
	<string>ThunderGate access to the Tigon3 Ethernet controller.</string>
	<key>IOKitPersonalities</key>
	<dict>
		<key>TGPCIDevice</key>
		<dict>
			<key>CFBundleIdentifier</key>
			<string>lol.ssj.thundergate.TGDext</string>
			<key>CFBundleIdentifierKernel</key>
			<string>com.apple.kpi.iokit</string>
			<key>IOClass</key>
			<string>IOUserService</string>
			<key>IOUserClass</key>
			<string>TGPCIDevice</string>
			<key>IOUserServerName</key>
			<string>lol.ssj.thundergate.TGDext</string>
			<key>IOProviderClass</key>
			<string>IOPCIDevice</string>
			<!--
			   IOPCITunnelCompatible: Tigon3 adapters attach over
			   Thunderbolt, so the PCI device is tunnelled
			   (IOPCITunnelled = Yes). IOKit will not match a driver to a
			   tunnelled PCI device unless the driver declares it is
			   tunnel-safe -- without this the dext is never considered.
			-->
			<key>IOPCITunnelCompatible</key>
			<true/>
			<!--
			   IOProbeScore: the Tigon3 is also matched by the built-in
			   AppleBCM5701Ethernet kext, which probes at score 2048 in
			   the default match category. To drive the device, this dext
			   must outscore it; 100000 wins decisively. (A re-match is
			   still needed after install -- replug the adapter.)
			-->
			<key>IOProbeScore</key>
			<integer>100000</integer>
			<!--
			   IOPCIMatch: space-separated (deviceID << 16 | vendorID)
			   values (0x????14e4 = Broadcom; 0x168288b5 = a ThunderGate-cloaked Tigon, vendor 0x88b5). 0x1682 is ThunderGate's
			   historical default (see py/main.py); the rest cover common
			   standalone Tigon3 NICs. Add your device's ID here -- find
			   it with `system_profiler SPPCIDataType` or lspci.
			-->
			<key>IOPCIMatch</key>
			<string>0x168214e4 0x164414e4 0x164514e4 0x164614e4 0x164714e4 0x164814e4 0x165314e4 0x165914e4 0x167714e4 0x168414e4 0x168288b5</string>
			<key>UserClientProperties</key>
			<dict>
				<key>IOClass</key>
				<string>IOUserUserClient</string>
				<key>IOUserClass</key>
				<string>TGUserClient</string>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
