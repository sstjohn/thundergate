<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	   DriverKit entitlements for the ThunderGate dext.

	   com.apple.developer.driverkit and ...transport.pci are restricted:
	   for a signed, notarized build Apple must grant them to the
	   developer account. For local development they need not be granted
	   at all -- build with "Sign to Run Locally", SIP disabled, and
	   `systemextensionsctl developer on`. See doc/INSTALL.macos.md.
	-->
	<key>com.apple.developer.driverkit</key>
	<true/>
	<key>com.apple.developer.driverkit.transport.pci</key>
	<array>
		<dict>
			<key>IOPCIMatch</key>
			<string>0x168214e4 0x164414e4 0x164514e4 0x164614e4 0x164714e4 0x164814e4 0x165314e4 0x165914e4 0x167714e4 0x168414e4</string>
		</dict>
	</array>
	<key>com.apple.developer.driverkit.allow-any-userclient-access</key>
	<true/>
</dict>
</plist>
