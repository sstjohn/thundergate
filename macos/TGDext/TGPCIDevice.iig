/*
 * TGPCIDevice -- the ThunderGate dext's matching IOService.
 *
 * It matches the Tigon3 PCI device (Info.plist IOKitPersonalities),
 * opens it, keeps a descriptor for BAR 0, owns the DMA buffers and the
 * MSI interrupt source, and vends a TGUserClient.
 *
 * BUILD NOTE: .iig files are processed by Xcode's `iig` tool -- this
 * dext must be built from an Xcode DriverKit target (see
 * doc/INSTALL.macos.md). The DriverKit / PCIDriverKit API calls in the
 * matching .cpp target the current SDK; verify signatures against the
 * installed SDK headers when the Xcode project is first built.
 */

#ifndef TGPCIDevice_h
#define TGPCIDevice_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOMemoryDescriptor.iig>
#include <DriverKit/IOInterruptDispatchSource.iig>

class TGPCIDevice: public IOService
{
public:
    virtual bool init() override;
    virtual void free() override;

    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;

    virtual kern_return_t NewUserClient(uint32_t type,
                                        IOUserClient ** userClient) override;

    /*
     * Helpers invoked by TGUserClient. Both objects live in this dext,
     * so these are local (in-process) calls, not cross-process IPC.
     */

    /* --- config space + BAR 0 ----------------------------------------- */
    virtual kern_return_t ConfigRead32(uint64_t offset, uint32_t * value);
    virtual kern_return_t ConfigWrite32(uint64_t offset, uint32_t value);
    virtual kern_return_t GetBAR0Size(uint64_t * size);
    virtual kern_return_t CopyBAR0Memory(IOMemoryDescriptor ** memory);

    /* --- DMA buffers + interrupts ------------------------------------- */
    virtual kern_return_t AllocDMA(uint64_t size, uint64_t * handle,
                                   uint64_t * iova);
    virtual kern_return_t FreeDMA(uint64_t handle);
    virtual kern_return_t CopyDMAMemory(uint64_t handle,
                                        IOMemoryDescriptor ** memory);

    /* The user client registers itself so interrupts can be delivered. */
    virtual kern_return_t RegisterClient(IOUserClient * client);
    virtual kern_return_t UnregisterClient(void);

    /* Bound to the MSI IOInterruptDispatchSource. */
    virtual void InterruptOccurred(OSAction * action, uint64_t count,
                                   uint64_t time)
        TYPE(IOInterruptDispatchSource::InterruptOccurred);
};

#endif /* TGPCIDevice_h */
