/*
 * TGUserClient -- the IOUserClient TGPCIDevice vends to user space.
 *
 * ExternalMethod dispatches the config-space selectors defined in
 * tg_dext.h; CopyClientMemoryForType hands BAR 0 to IOConnectMapMemory.
 * py/interfaces/macos.py is the user-space peer.
 */

#ifndef TGUserClient_h
#define TGUserClient_h

#include <Availability.h>
#include <DriverKit/IOUserClient.iig>
#include <DriverKit/IOMemoryDescriptor.iig>

class TGUserClient: public IOUserClient
{
public:
    virtual bool init() override;
    virtual void free() override;

    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;

    virtual kern_return_t ExternalMethod(
                uint64_t selector,
                IOUserClientMethodArguments * arguments,
                const IOUserClientMethodDispatch * dispatch,
                OSObject * target,
                void * reference) override;

    virtual kern_return_t CopyClientMemoryForType(
                uint64_t type,
                uint64_t * options,
                IOMemoryDescriptor ** memory) override;
};

#endif /* TGUserClient_h */
